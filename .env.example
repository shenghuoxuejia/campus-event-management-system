# 复制本文件为 .env，并填入真实值。
# .env 已被 .gitignore 忽略，绝对不要提交到仓库。

# ---- 数据库连接 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=在这里填你的 MySQL 密码
DB_NAME=campus_events
TEST_DB_NAME=campus_events_test

# ---- 应用密钥（用于签名登录令牌）----
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 注意：占位符或长度 < 32 会被 app.py 直接拒绝启动
APP_SECRET_KEY=在这里填一段随机长字符串

# ---- 令牌有效期（秒），默认 24 小时 ----
TOKEN_MAX_AGE=86400

# ---- 调试模式：1 开启 / 0 关闭（生产环境请用 0）----
FLASK_DEBUG=0

# ---- 登录 / 注册限流（格式：次数/窗口秒数）----
# 登录：同一 IP + 同一邮箱 10 次 / 60 秒；注册：同一 IP 20 次 / 3600 秒
LOGIN_RATE_LIMIT=10/60
REGISTER_RATE_LIMIT=20/3600
# 评论：同一用户 20 条 / 60 秒
COMMENT_RATE_LIMIT=20/60

# ---- 数据库连接池大小 / 会话时区 ----
# 会话时区固定后，所有 NOW() 判断与页面展示时间一致（默认东八区）
DB_POOL_SIZE=5
DB_TIME_ZONE=+08:00

# ---- 后端端口 ----
PORT=5000

# ---- 允许的跨域来源（逗号分隔；默认 * 表示全部）----
# 生产环境建议改为具体来源，例如：CORS_ORIGINS=http://127.0.0.1:5000
CORS_ORIGINS=*

# ---- 可信反向代理（逗号分隔；只在这些 IP 来的请求里才解析 X-Forwarded-For）----
# 没有反向代理就留空，防止攻击者伪造 XFF 绕过限流
TRUSTED_PROXIES=
