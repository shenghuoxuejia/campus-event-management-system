# 复制本文件为 .env，并填入真实值。
# .env 已被 .gitignore 忽略，绝对不要提交到仓库。

# ---- 数据库连接 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=在这里填你的 MySQL 密码
DB_NAME=campus_events

# ---- 应用密钥（用于签名登录令牌）----
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=在这里填一段随机长字符串

# ---- 令牌有效期（秒），默认 24 小时 ----
TOKEN_MAX_AGE=86400

# ---- 调试模式：1 开启 / 0 关闭（生产环境请用 0）----
FLASK_DEBUG=0

# ---- 后端端口 ----
PORT=5000
